# Claude Code session state — not source of truth (only commit skills + settings, not transient project state).
.claude/projects/

# Paper-reading raw artifacts (heavy intermediate files — only the final cropped figures
# in papers/*/figures/ ship to the published blog).
papers/*/raw/
papers/*/figures-raw/
papers/*/repo/
papers/*/repo_*/
papers/*/repo-*/
papers/*/eprint/

# Writing-tutorial raw artifacts (only final figures + index.html + plan.md + MANIFEST.md
# need to ship; sources and code-excerpts are large intermediate working files).
tutorials/*/figures-raw/
tutorials/*/sources/repos/
tutorials/*/code-excerpts/
tutorials/*/sources/papers/*.pdf
tutorials/*/sources/papers/*.txt
tutorials/*/drafts/

# Local server log
paper-reading-server.log

# Dev-only blog full-page screenshots (not referenced from any index.html)
papers/*/blog-fullpage.png
papers/*/blog-viewport*.png

# macOS / editors
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
.pytest_cache/
*.pyc
